{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Caminho ou URL do JSON Schema, para autocomplete no editor. Ignorado pelo crudmaker."
    },
    "system": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "description": "Código do sistema. Lido e guardado, mas não afeta a saída."
        },
        "title": {
          "type": "string",
          "description": "Título do sistema. Não usado."
        }
      },
      "required": [
        "code"
      ],
      "description": "Dados do sistema."
    },
    "pkg": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "description": "Código do pacote (nome do projeto)."
        },
        "entities": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "fields": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "string",
                      "enum": [
                        "uuid",
                        "string",
                        "text",
                        "date",
                        "datetime",
                        "double",
                        "integer",
                        "boolean",
                        "json",
                        "enum",
                        "int",
                        "displayName"
                      ],
                      "description": "Tipo do campo. Aliases: \"int\" vira \"integer\"; \"displayName\" vira um campo string chamado display_name."
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "enum": [
                            "uuid",
                            "string",
                            "text",
                            "date",
                            "datetime",
                            "double",
                            "integer",
                            "boolean",
                            "json",
                            "enum",
                            "int",
                            "displayName"
                          ],
                          "description": "Tipo do campo. Aliases: \"int\" vira \"integer\"; \"displayName\" vira um campo string chamado display_name."
                        },
                        "name": {
                          "type": "string",
                          "description": "Nome da coluna. Padrão: a chave do campo."
                        },
                        "required": {
                          "type": "boolean",
                          "description": "false deixa a coluna nullable. Padrão: true."
                        },
                        "unique": {
                          "type": "boolean",
                          "description": "true cria índice único e a regra Rule::unique. Padrão: false."
                        },
                        "enumItems": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          },
                          "description": "Valores permitidos quando type é \"enum\" (ao menos um). Padrão: []."
                        },
                        "hidden": {
                          "type": "boolean",
                          "description": "true tira o campo da resource (e o põe em $hidden da model); continua no $fillable e na validação. Padrão: false."
                        },
                        "rules": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          },
                          "description": "Regras extras de validação do Laravel (ex.: [\"max:120\", \"email\"]), somadas às derivadas do tipo, depois delas e sem repetir. O crudmaker não confere se a regra existe; o hook extraRules() da request final pode substituir tudo."
                        },
                        "default": {
                          "description": "Valor padrão da coluna (->default(...) na migration). Deve combinar com o tipo: texto para string, text, uuid, date (\"Y-m-d\"), datetime (\"Y-m-d H:i:s\") e enum (um dos enumItems; substitui o padrão, que é o primeiro item); inteiro para integer; número para double; true/false para boolean. Não vale para json.",
                          "type": [
                            "string",
                            "number",
                            "boolean"
                          ]
                        }
                      },
                      "required": [
                        "type"
                      ]
                    }
                  ],
                  "description": "Campo: forma curta (só o tipo, ex.: \"string\") ou objeto com type, name, required, unique, enumItems, hidden, rules e default."
                },
                "description": "Campos da entidade (chave = nome do campo). Declare sempre \"id\": \"uuid\"."
              },
