                                "ownMany",
                                "morphOne",
                                "morphMany",
                                "belongsTo",
                                "morphTo",
                                "owned",
                                "morphed"
                              ],
                              "description": "Sobrescreve o tipo do relacionamento. Padrão: o tipo da lista em que o item está."
                            }
                          },
                          "required": [
                            "entity"
                          ]
                        }
                      ],
                      "description": "Relacionamento: nome da entidade (ex.: \"client\") ou objeto com entity, field, required e relationship."
