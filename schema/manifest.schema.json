                              "description": "Nome da entidade relacionada (chave em pkg.entities)."
                            },
                            "field": {
                              "type": "string",
                              "description": "Nome da coluna de FK. Padrão: <entity>_id."
                            },
                            "required": {
                              "type": "boolean",
                              "description": "false deixa a FK nullable. Padrão: true."
