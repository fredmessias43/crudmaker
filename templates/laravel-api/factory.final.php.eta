<?php

namespace <%~ it.namespace %>;

<% for (const use of it.imports) { -%>
use <%~ use %>;
<% } -%>

/**
 * Camada de customização da factory de <%~ it.entity.pascal %>.
 *
 * Este arquivo é seu: o crudmaker o criou uma única vez e nunca o sobrescreve.
 * Os valores padrão (definition()) ficam em
 * <%~ it.base.fqcn %> (<%~ it.base.path %>), que não deve ser editada.
 */
class <%~ it.className %> extends <%~ it.extends %>
{
	/*
	 * Estados: variações nomeadas, usadas como <%~ it.entity.pascal %>::factory()->exemplo()->create().
	 *
	 *   public function exemplo(): static
	 *   {
	 *       return $this->state(fn (array $attributes) => [
	 *           'campo' => 'valor',
	 *       ]);
	 *   }
	 *
	 * Para trocar um valor padrão, sobrescreva a definition() e parta da base:
	 *
	 *   public function definition(): array
	 *   {
	 *       return array_merge(parent::definition(), [
	 *           'campo' => 'valor',
	 *       ]);
	 *   }
	 */
}
